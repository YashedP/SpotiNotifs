{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Spotify Catchup",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/spotify.py",
            "args": ["catchup", "${input:catchup_start_date}", "${input:catchup_end_date}", "--user", "${input:catchup_user_uuid}"],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Spotify Normal",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/spotify.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "catchup_user_uuid",
            "type": "promptString",
            "description": "User UUID from python spotify.py users list"
        },
        {
            "id": "catchup_start_date",
            "type": "promptString",
            "description": "Inclusive catch-up start date (YYYY-MM-DD)"
        },
        {
            "id": "catchup_end_date",
            "type": "promptString",
            "description": "Inclusive catch-up end date (YYYY-MM-DD)"
        }
    ]
}
